# Runtime
ENV=production
APP_PORT=3015
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8483

# Frontend
VITE_API_BASE_URL=/api
VITE_SCREENSHOT_BASE_URL=/static/screenshots
VITE_FRONTEND_PORT=3015

# Backend paths
STATIC=/static
OUT_DIR=./static/screenshots
NOTE_OUTPUT_DIR=note_results
IMAGE_BASE_URL=/static/screenshots
DATA_DIR=data

# Python package mirror used by Docker builds
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# FFmpeg
FFMPEG_BIN_PATH=

# Transcriber
TRANSCRIBER_TYPE=bcut
WHISPER_MODEL_SIZE=tiny

GROQ_TRANSCRIBER_MODEL=whisper-large-v3-turbo

# Online verification search
ONLINE_VERIFY_SEARCH_PROVIDER=brave
ONLINE_VERIFY_SEARCH_FALLBACK_PROVIDERS=bing_academic,bing_cn,baidu
BRAVE_SEARCH_API_KEY=your_brave_search_api_key
BRAVE_SEARCH_COUNTRY=CN
BRAVE_SEARCH_LANG=zh-hans
BRAVE_SEARCH_UI_LANG=zh-CN
