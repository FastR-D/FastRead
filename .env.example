# Runtime
ENV=production
APP_PORT=3015
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8483
MAX_UPLOAD_BYTES=67108864

# Frontend
VITE_API_BASE_URL=/api
VITE_SCREENSHOT_BASE_URL=/static/screenshots
VITE_FRONTEND_PORT=3015

# Backend paths
STATIC=/static
OUT_DIR=./static/screenshots
PAPER_OUTPUT_DIR=paper_results
IMAGE_BASE_URL=/static/screenshots
DATA_DIR=data

# Python package mirror used by Docker builds
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple


# Paper metadata discovery. Related-work search never adjudicates truth.
PAPER_SEARCH_DEADLINE=8
# Optional proxy for public academic providers only; local APIs and Elasticsearch stay direct.
PAPER_SEARCH_PROXY_URL=
# China deployment: Crossref is primary and OpenAlex supplements arXiv metadata.
PAPER_SEARCH_REQUIRE_PROXY=false
CROSSREF_API_URL=https://api.crossref.org/works
OPENALEX_API_URL=https://api.openalex.org/works
CROSSREF_MAILTO=
ELASTICSEARCH_URL=http://127.0.0.1:9200
PAPER_SEARCH_ES_REPLICAS=0
GOOGLE_SCHOLAR_API_URL=
SERPAPI_API_KEY=

# Local multilingual paper retrieval. The pinned ONNX model is cached on first use.
CHAT_VECTOR_INDEX_ENABLED=auto
CHAT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHAT_EMBEDDING_MODEL_REVISION=faf4aa4225822f3bc6376869cb1164e8e3feedd0
# Domestic mirror used only to download the pinned model revision.
HF_ENDPOINT=https://hf-mirror.com
CHAT_EMBEDDING_CACHE_DIR=models/embedding
CHAT_EMBEDDING_THREADS=4
CHAT_EMBEDDING_MODEL_DIR=

# Optional OpenAI-compatible model provider examples.
# Configure real model providers in the app database/settings UI when possible.
# Do not commit real API keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
