# Runtime
ENV=production
APP_PORT=3015
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8483

# Frontend
VITE_API_BASE_URL=/api
VITE_FRONTEND_PORT=3015

# Backend paths
STATIC=/static
NOTE_OUTPUT_DIR=note_results
DATA_DIR=data

# Python package mirror used by Docker builds
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# Verification-first search.
# Search snippets are recall hints only; supported verdicts require fetched body/PDF evidence.
ONLINE_VERIFY_SEARCH_PROVIDER=brave
ONLINE_VERIFY_SEARCH_FALLBACK_PROVIDERS=bing_academic,bing_cn,baidu
BRAVE_SEARCH_API_KEY=your_brave_search_api_key
BRAVE_SEARCH_COUNTRY=CN
BRAVE_SEARCH_LANG=zh-hans
BRAVE_SEARCH_UI_LANG=zh-CN

# Optional OpenAI-compatible model provider examples.
# Configure real model providers in the app database/settings UI when possible.
# Do not commit real API keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
