
# 通用
ENV=production
API_BASE_URL=http://127.0.0.1:8483
STATIC=/static # 外部访问路径（URL 前缀）
DATA_DIR=data
NOTE_OUTPUT_DIR=note_results
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8483

# Verification-first search.
# 搜索摘要只用于召回；supported 必须来自抓取到的网页/PDF 正文证据。
# 没有 Brave key、检索失败、抓取失败或只有弱来源时，系统应降级为 non-supported / data_void，而不是输出 supported。
# 搜索源：brave(推荐，API 稳定) / bing_academic / bing_cn / baidu / duckduckgo
ONLINE_VERIFY_SEARCH_PROVIDER=brave
ONLINE_VERIFY_SEARCH_FALLBACK_PROVIDERS=bing_academic,bing_cn,baidu
BRAVE_SEARCH_API_KEY=your_brave_search_api_key
# 可选：CN / US / ALL 等；中国大陆环境默认 CN
BRAVE_SEARCH_COUNTRY=CN
# 可选：zh-hans / en 等
BRAVE_SEARCH_LANG=zh-hans
# 可选：zh-CN / en-US 等
BRAVE_SEARCH_UI_LANG=zh-CN

# 可选 OpenAI-compatible provider 示例。
# 真实 key 不要写入仓库；优先在本地数据库/设置页配置 provider。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
