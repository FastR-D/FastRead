
# 通用
ENV=production
API_BASE_URL=http://127.0.0.1:8483
SCREENSHOT_BASE_URL=http://127.0.0.1:8483/static/screenshots
STATIC=/static # 外部访问路径（URL 前缀）
OUT_DIR=./static/screenshots    # 本地输出目录
IMAGE_BASE_URL=/static/screenshots  # 图片访问 URL
DATA_DIR=data
PAPER_OUTPUT_DIR=paper_results
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8483
MAX_UPLOAD_BYTES=67108864
# 论文元数据检索；近邻论文只做发现与排序，不做真假裁决。
PAPER_SEARCH_DEADLINE=8
# 仅代理公共学术元数据请求；不影响本地 API 或 Elasticsearch。
PAPER_SEARCH_PROXY_URL=
# 境内部署默认直连：Crossref 主检索，OpenAlex 补充 arXiv。
PAPER_SEARCH_REQUIRE_PROXY=false
CROSSREF_API_URL=https://api.crossref.org/works
OPENALEX_API_URL=https://api.openalex.org/works
CROSSREF_MAILTO=
ELASTICSEARCH_URL=http://127.0.0.1:9200
PAPER_SEARCH_ES_REPLICAS=0
GOOGLE_SCHOLAR_API_URL=
SERPAPI_API_KEY=

# 本地论文多语言向量检索。首次使用会后台下载约 0.22 GB 的固定版本 ONNX 模型。
CHAT_VECTOR_INDEX_ENABLED=auto
CHAT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHAT_EMBEDDING_MODEL_REVISION=faf4aa4225822f3bc6376869cb1164e8e3feedd0
# 仅作为固定 revision 的国内下载入口。
HF_ENDPOINT=https://hf-mirror.com
CHAT_EMBEDDING_CACHE_DIR=models/embedding
CHAT_EMBEDDING_THREADS=4
# 离线部署可指向预置模型目录；为空时使用上面的固定版本缓存/下载。
CHAT_EMBEDDING_MODEL_DIR=

# 可选 OpenAI-compatible provider 示例。
# 真实 key 不要写入仓库；优先在本地数据库/设置页配置 provider。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
