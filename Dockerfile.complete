FROM golang:1.26.8-bookworm AS api
WORKDIR /src
COPY backend-go/go.mod backend-go/go.sum ./
RUN go mod download
COPY backend-go/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /fastread ./cmd/fastread

FROM node:24-bookworm-slim AS web
RUN npm install --global pnpm@9.15.0
WORKDIR /src
COPY fastread-frontend/package.json fastread-frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY fastread-frontend/ ./
RUN pnpm build

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates poppler-utils tini curl && rm -rf /var/lib/apt/lists/*
COPY --from=api /fastread /usr/local/bin/fastread
COPY --from=web /src/dist /app/web
COPY deploy/web/container-entrypoint.sh /usr/local/bin/fastread-start
RUN chmod +x /usr/local/bin/fastread-start
ENV FASTREAD_WEB_ROOT=/var/lib/fastread/web FASTREAD_DATA_ROOT=/var/lib/fastread/config FASTREAD_FRONTEND_DIST=/app/web FASTREAD_COOKIE_SECURE=false
VOLUME /var/lib/fastread
EXPOSE 80
HEALTHCHECK --interval=20s --timeout=5s CMD curl -fsS http://127.0.0.1/api/health || exit 1
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/fastread-start"]
