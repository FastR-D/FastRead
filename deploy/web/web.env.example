FASTREAD_WEB_ROOT=/home/dev/fastread-web-shared/data
FASTREAD_DATA_ROOT=/home/dev/fastread-web-shared/compatibility
FASTREAD_WEB_DIST=/home/dev/fastread-web-current/fastread-frontend/dist
FASTREAD_PUBLIC_ORIGIN=https://fastread.example.com
FASTREAD_COOKIE_SECURE=true
FASTREAD_DEFAULT_MODEL=qwen3.8-27b
# Copy the existing restricted arXiv gateway settings into the candidate environment.
# Never point either data root at production legacy data.

# FastResearch personal-key SSO. FastRead never collects the raw key.
FASTRESEARCH_API_URL=http://127.0.0.1:8787
FASTRESEARCH_PANEL_URL=http://127.0.0.1:5173
