{
  "compilerOptions": {
    "incremental": false,
    "target": "es2016",
    "jsx": "preserve",
    "lib": ["DOM", "ESNext"],
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "node",
    "paths": {
      "~/*": ["src/*"]
    },
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "*.d.ts",
    "src/auto-imports.d.ts",
    "src/env.ts",
    "src/global.d.ts",
    "src/manifest.ts",
    "src/composables/useWebExtensionStorage.ts",
    "src/logic/api.ts",
    "src/logic/common-setup.ts",
    "src/logic/constants.ts",
    "src/logic/cookies.ts",
    "src/logic/storage.ts",
    "src/logic/types.ts",
    "src/popup/**/*.ts",
    "src/popup/**/*.vue",
    "src/styles/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts",
    "*.config.mts"
  ],
  "exclude": ["dist", "node_modules", "extension"]
}
